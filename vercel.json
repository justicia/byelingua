{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron?slot=1",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron?slot=2",
      "schedule": "10 6 * * *"
    },
    {
      "path": "/api/cron?slot=3",
      "schedule": "20 6 * * *"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    },
    "api/cron.py": {
      "maxDuration": 60
    }
  }
}
