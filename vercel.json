{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron?timezone=summer",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron?timezone=winter",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    },
    "api/cron.py": {
      "maxDuration": 300
    }
  }
}
