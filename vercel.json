{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "runtime": "python3.12"
    },
    "api/cron.py": {
      "runtime": "python3.12"
    }
  },
  "rewrites": [
    {
      "source": "/set-password",
      "destination": "/set-password.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron?timezone=summer",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron?timezone=winter",
      "schedule": "0 8 * * *"
    }
  ]
}
