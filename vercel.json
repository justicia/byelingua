{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/cron.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/set-password",
      "destination": "/set-password.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron?timezone=summer",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron?timezone=winter",
      "schedule": "0 8 * * *"
    }
  ]
}
